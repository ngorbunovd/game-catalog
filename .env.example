# Скопируйте в .env и заполните:  cp .env.example .env

# Пароль преподавателя (Basic Auth для /admin и модерации заявок)
ADMIN_PASSWORD=change-me

# Секрет для подписи cookie сессий (лайки). Сгенерировать: openssl rand -hex 32
# Менять его нельзя после запуска — слетят все сессии и лайки.
SESSION_SECRET=change-me

# Порт на сервере, по которому открывается каталог.
# 80 — сразу по адресу сервера без указания порта.
HOST_PORT=3000
